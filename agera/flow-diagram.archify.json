  "cards": [
    {
      "dot": "cyan",
      "title": "取消与重启",
      "items": [
        "update() 先 maybeCancelFlow 再 maybeStartFlow；CANCEL_FLOW 在指令边界生效（L146-150、L182-205）",
        "被取消时经 MSG_CALL_ACKNOWLEDGE_CANCEL 丢弃中间值并回收（L230-249）"
      ]
    },
    {
      "dot": "violet",
      "title": "惰性与打断",
      "items": [
        "goLazy 之后数据流暂停，get() 时才在调用线程继续执行剩余指令（L604-620）",
        "goTo 之前同步执行；之后可被 SEND_INTERRUPT 打断（L189-196、L285-308）"
      ]
    }
  ]
