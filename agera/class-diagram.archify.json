  "cards": [
    {
      "dot": "cyan",
      "title": "两个状态",
      "items": [
        "没有 Updatable 时，deferred 仓库处于 inactive，get() 不保证新鲜（Repository L30-47）",
        "首个 Updatable 加入触发 observableActivated()，CompiledRepository 据此挂到事件源并启动数据流（L134-138）"
      ]
    },
    {
      "dot": "violet",
      "title": "编译期校验",
      "items": [
        "RepositoryCompiler 用 Expect 状态机逐条校验链式调用顺序（L75-86、L118-120）",
        "compile() 把 directives 列表压成 Object[]，由 CompiledRepository 的 switch 解释执行（L312-344）"
      ]
    }
  ]
}