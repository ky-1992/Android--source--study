  "cards": [
    {
      "dot": "cyan",
      "title": "示例组织方式",
      "items": [
        "MainFragment 每个 @OnClick 直接 new 一个示例 Fragment，用 addToBackStack 后 replace 进 android.R.id.content",
        "示例之间不共享状态；需要跨页面通信时才走 MainActivity 暴露的 RxBus 单例"
      ]
    },
    {
      "dot": "violet",
      "title": "网络与线程",
      "items": [
        "GithubService 用 RxJava2CallAdapterFactory + GsonConverterFactory 构建 Retrofit，token 交给 OkHttp 拦截器注入",
        "示例统一 subscribeOn(Schedulers.io()) + observeOn(AndroidSchedulers.mainThread())，销毁时 dispose CompositeDisposable"
      ]
    }
  ]
