  "cards": [
    {
      "dot": "cyan",
      "title": "两次 drawCircle",
      "items": [
        "内容圆用 mBitmapPaint（BitmapShader + mDrawableRadius），边框圆用 mBorderPaint（STROKE + mBorderRadius）",
        "mBorderOverlay 为 false 时 mDrawableRect 先 inset 边框宽度减 1，内容不会盖住边框"
      ]
    },
    {
      "dot": "amber",
      "title": "CENTER_CROP 的等价实现",
      "items": [
        "updateShaderMatrix 比较位图与内容矩形的宽高比，取较大缩放并居中平移",
        "mRebuildShader 用标记位延后到 onDraw 才 new BitmapShader，避免每帧重新分配"
      ]
    }
