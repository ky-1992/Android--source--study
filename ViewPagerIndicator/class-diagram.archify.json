  "cards": [
    {
      "dot": "cyan",
      "title": "统一契约",
      "items": [
        "PageIndicator 继承 ViewPager.OnPageChangeListener，指示器本身就是监听器，绑定即注册",
        "setOnPageChangeListener 只做事件二次转发，不改变内部状态"
      ]
    },
    {
      "dot": "violet",
      "title": "两种渲染风格",
      "items": [
        "Circle / Line / Underline / Title 直接继承 View，靠 onDraw 用 Canvas 画",
        "Tab / Icon 继承 HorizontalScrollView，用 IcsLinearLayout 装子 View，靠点击反推页码"
      ]
    }
  ]
