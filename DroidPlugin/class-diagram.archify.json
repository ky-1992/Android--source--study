  "cards": [
    {
      "dot": "cyan",
      "title": "安装路径",
      "items": [
        "installPackage 先用宿主 PackageManager 读包名，把 apk 复制到私有目录，再用 PluginPackageParser 解析组件列表",
        "解析后 mPluginCache.put(包名, parser)，触发 onPkgInstalled 与 PACKAGE_ADDED 广播；dexOpt 里只构造 PluginClassLoader 触发优化"
      ]
    },
    {
      "dot": "violet",
      "title": "占坑与 Hook",
      "items": [
        "IActivityManagerHook.onInstall 反射拿到 IActivityManager 的 gDefault/Singleton，用 MyProxy 生成动态代理替换回去",
        "IActivityManagerHookHandle 用方法名映射把 startActivity 等改写成「桩组件 + EXTRA_TARGET_INTENT」，桩组件由 ActivityStub 预注册"
      ]
    }
  ]
}
