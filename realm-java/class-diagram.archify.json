  "cards": [
    {
      "dot": "cyan",
      "title": "受管对象与代理",
      "items": [
        "注解处理器为每个 RealmObject 子类生成 xxxRealmProxy，代理实现 RealmObjectProxy 并持有一个 ProxyState",
        "ProxyState.row 指向 native 行；对象被删除或 Realm 关闭后 checkValidObject 抛 IllegalStateException"
      ]
    },
    {
      "dot": "violet",
      "title": "JNI 边界",
      "items": [
        "Java 层每个 native 对象都用 NativeObject 包裹一个 long 指针，由 NativeContext 引用队列负责释放",
        "OsSharedRealm 把 RealmConfiguration 翻译成 OsRealmConfig，再调用 nativeGetSharedRealm 打开文件"
      ]
    }
  ]
}