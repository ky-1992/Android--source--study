  "cards": [
    {
      "dot": "cyan",
      "title": "示例的组织约定",
      "items": [
        "每个示例是独立 Gradle 工程（自己的 settings.gradle + gradle wrapper），共用 projects.conf 列出的目录名",
        "用例放 androidTest 或 sharedTest，被测 Activity 放 main，ROOT_TEXT 之类常量用 @VisibleForTesting 暴露给测试"
      ]
    },
    {
      "dot": "violet",
      "title": "关键 API 落点",
      "items": [
        "Espresso：onView / onData / perform / check(matches(...))，ActivityScenarioRule 取代旧 ActivityTestRule",
        "UI Automator：UiDevice.getInstance，By.res(pkg, id) 与 Until.findObject 轮询，跨进程不依赖被测代码",
        "IdlingResource：SimpleIdlingResource 用 AtomicBoolean 记状态，setIdleState(true) 时回调 onTransitionToIdle 通知 Espresso 继续"
      ]
    }
  ]
}
