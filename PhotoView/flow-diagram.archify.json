  "cards": [
    {
      "dot": "cyan",
      "title": "基准矩阵何时重算",
      "items": [
        "setImageDrawable / setImageResource / setImageURI 与 setFrame 变化都会调用 attacher.update()",
        "onLayoutChange 检测到边界变化时只重算 updateBaseMatrix，不重置用户已缩放的 Supp 矩阵"
      ]
    },
    {
      "dot": "amber",
      "title": "越界回弹",
      "items": [
        "ACTION_UP / ACTION_CANCEL 时若 getScale() 小于 min 或大于 max，会 post AnimatedZoomRunnable 动画归位",
        "checkMatrixBounds 在宽高小于视口时按 ScaleType 对齐，否则把空白边贴回视口"
      ]
    }
  ]
