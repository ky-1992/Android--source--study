  "cards": [
    {
      "dot": "cyan",
      "title": "矩阵三层结构",
      "items": [
        "mBaseMatrix 由 updateBaseMatrix 按 ScaleType 算出，只随尺寸与旋转变化",
        "mSuppMatrix 承接手势增量，getDrawMatrix 把两者 postConcat 后交给 ImageView"
      ]
    },
    {
      "dot": "violet",
      "title": "触摸优先级",
      "items": [
        "CustomGestureDetector 先消费缩放与拖拽，GestureDetector 再判断单击/双击",
        "onTouch 在 ACTION_UP 时若越界，会 post AnimatedZoomRunnable 回弹到 min/max"
      ]
    }
  ]
}