    {
      "dot": "cyan",
      "title": "一次注解处理的三阶段",
      "items": [
        "ModelExtractor 从 RoundEnvironment 收集被注解元素",
        "AnnotationHandlers 按注解类型分发给对应 Handler 校验",
        "GeneratingAnnotationHandler 生成 Xxx_ 子类源码，交给 CodeModelGenerator"
      ]
    },
    {
      "dot": "violet",
      "title": "扩展方式",
      "items": [
        "新增注解 = 定义注解 + 实现 AnnotationHandler + 通过插件注册",
        "环境接口让同一套处理器同时支持 javac 注解处理与服务端独立运行"
      ]
    }
