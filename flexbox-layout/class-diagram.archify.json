  "cards": [
    {
      "dot": "cyan",
      "title": "两套容器一份算法",
      "items": [
        "FlexboxLayout 与 FlexboxLayoutManager 都实现 FlexContainer",
        "FlexboxHelper 只依赖 FlexContainer 接口，测量/换行逻辑完全复用"
      ]
    },
    {
      "dot": "violet",
      "title": "子项属性从 LayoutParams 来",
      "items": [
        "order 参与重排：createReorderedIndices 生成 mReorderedIndices",
        "flexGrow / flexShrink / alignSelf / flexBasisPercent 决定主轴伸缩"
      ]
    },
    {
      "dot": "amber",
      "title": "FlexLine 是行的账本",
      "items": [
        "记录 mMainSize、mCrossSize 与 first/last index",
        "mIndicesAlignSelfStretch 保存需要拉伸的子项下标"
      ]
    }
  ]
