  "cards": [
    {
      "dot": "cyan",
      "title": "换行判定条件",
      "items": [
        "flexWrap 为 NOWRAP、MeasureSpec 为 UNSPECIFIED 时直接不换行",
        "达到 maxLine 上限也停止拆行；否则比较 maxSize < currentLength + childLength"
      ]
    },
    {
      "dot": "amber",
      "title": "尺寸三步走",
      "items": [
        "calculateFlexLines 先量出每行的主轴长度与交叉轴最大值",
        "determineMainSize 按 flexGrow/flexShrink 伸缩，determineCrossSize 处理 alignContent",
        "stretchViews 把 alignSelf=STRETCH 的子项撑满行高"
      ]
    },
    {
      "dot": "emerald",
      "title": "布局阶段",
      "items": [
        "onLayout 先按方向与 RTL / WRAP_REVERSE 求 isRtl",
        "layoutSingleChildHorizontal 结合 alignItems 与 margin 计算每条边的最终坐标"
      ]
    }
  ]
