  "cards": [
    {
      "dot": "cyan",
      "title": "两套入口",
      "items": [
        "ItemAnimator 路线：BaseItemAnimator 子类挂在 RecyclerView.itemAnimator 上，处理增删移改",
        "Adapter 路线：AnimationAdapter 包一层原 Adapter，在 onBindViewHolder 里播放入场动画"
      ]
    },
    {
      "dot": "violet",
      "title": "子类要写的三件事",
      "items": [
        "preAnimateAddImpl 摆好初始属性，animateAddImpl / animateRemoveImpl 用 ViewPropertyAnimator 归位",
        "listener 必须传 DefaultAddAnimatorListener 或 DefaultRemoveAnimatorListener，否则 dispatch 不会回调、isRunning 卡住"
      ]
    },
    {
      "dot": "amber",
      "title": "change 动画默认关闭",
      "items": [
        "init 里 supportsChangeAnimations = false（L48–L50），需要时自行打开",
        "animateChange 遇到同一个 holder 会退化成 animateMove（L326–L330）"
      ]
    }
  ]
}
