  "cards": [
    {
      "dot": "cyan",
      "title": "为什么要排队",
      "items": [
        "remove 先跑；move 延迟 removeDuration；add 延迟 remove + max(move, change)，避免同屏打架",
        "每批用 ArrayList 拷贝 + Runnable，endAnimation 时能整批取消（L444–L507）"
      ]
    },
    {
      "dot": "violet",
      "title": "错峰延迟",
      "items": [
        "getRemoveDelay = |oldPosition * removeDuration / 4|，getAddDelay 用 adapterPosition",
        "位置越靠后启动越晚，列表滚动时形成波纹感"
      ]
    },
    {
      "dot": "amber",
      "title": "扩展点",
      "items": [
        "holder 实现 AnimateViewHolder 即可让同一 RecyclerView 的每个 item 有不同的增删动画",
        "AnimateViewHolder 走 holder 自己的 listener，子类 BaseItemAnimator 的默认 listener 不会被用到"
      ]
    }
  ]
