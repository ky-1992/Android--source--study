  "cards": [
    {
      "dot": "cyan",
      "title": "一次请求的生命周期",
      "items": [
        "get/post 等便捷方法统一落到 sendRequest：校验 handler、补 Content-Type、newAsyncHttpRequest 后 threadPool.submit",
        "RequestHandle 用 WeakReference 持有 Runnable，cancel 只置标志并 abort 请求，避免调用方泄漏"
      ]
    },
    {
      "dot": "violet",
      "title": "两级线程模型",
      "items": [
        "请求线程来自 Executors.newCachedThreadPool，阻塞点全在 AsyncHttpRequest.run 内",
        "ResponseHandler 默认绑定创建时的 Looper，用 ResponderHandler 把 onSuccess/onFailure 切回线程"
      ]
    }
  ]
}