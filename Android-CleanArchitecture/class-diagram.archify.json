  "cards": [
    {
      "dot": "cyan",
      "title": "依赖方向",
      "items": [
        "presentation → domain ← data：data 实现 domain 的 UserRepository，domain 不认识任何 Android 类",
        "UseCase 把线程调度收口：subscribeOn(ThreadExecutor)、observeOn(PostExecutionThread)"
      ]
    },
    {
      "dot": "violet",
      "title": "两次模型转换",
      "items": [
        "data 层 UserEntity → User（UserEntityDataMapper），去掉 JSON/网络字样",
        "presentation 层 User → UserModel（UserModelDataMapper），换成 UI 需要的字段"
      ]
    }
  ]
}