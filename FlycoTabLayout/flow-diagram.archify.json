  "cards": [
    {
      "dot": "cyan",
      "title": "指示器的三种形态",
      "items": [
        "onDraw 先按 mIndicatorStyle 分流：STYLE_TRIANGLE 画 Path 三角形，STYLE_BLOCK 画整块圆角矩形，STYLE_NORMAL 画底部短横条",
        "indicatorWidth 小于 0 时指示器宽度等于整个 Tab，大于 0 时以 Tab 中心对齐到固定宽度"
      ]
    },
    {
      "dot": "violet",
      "title": "另外两个控件的差异",
      "items": [
        "SlidingTabLayout 没有 ValueAnimator，靠 ViewPager.onPageScrolled 的 positionOffset 在 calcIndicatorRect 里插值，并 scrollTo 让当前 Tab 居中",
        "SegmentTabLayout 的 mIndicatorRect 由 calcIndicatorRect 按首/中/尾位置写 mRadiusArr，仅首尾外侧两角保留圆角"
      ]
    }
  ]
