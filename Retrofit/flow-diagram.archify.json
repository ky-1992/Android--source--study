  "cards": [
    {
      "dot": "cyan",
      "title": "一句话主线",
      "items": [
        "接口 → 动态代理 → 缓存的 ServiceMethod → OkHttpCall → OkHttp → Converter → Callback",
        "一次解析、多次复用：ServiceMethod 是 Retrofit 的性能核心"
      ]
    },
    {
      "dot": "violet",
      "title": "两条返回路径",
      "items": [
        "同步：execute() 在当前线程 parseResponse",
        "异步：enqueue() 在 okhttp 线程解析，再由 callbackExecutor 切主线程"
      ]
    },
    {
      "dot": "amber",
      "title": "协程与取消",
      "items": [
        "suspend 方法走 SuspendForResponse / SuspendForBody",
