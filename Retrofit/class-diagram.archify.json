  "cards": [
    {
      "dot": "cyan",
      "title": "三步读源码",
      "items": [
        "Retrofit.create → 动态代理，所有方法调用进入 InvocationHandler",
        "loadServiceMethod → 首次解析注解并写入 ConcurrentHashMap 缓存",
        "HttpServiceMethod.invoke → new OkHttpCall + CallAdapter.adapt 得到返回类型"
      ]
    },
    {
      "dot": "violet",
      "title": "两组工厂",
      "items": [
        "CallAdapter.Factory 决定方法返回什么（Call、Observable、suspend）",
        "Converter.Factory 决定请求体与响应体如何序列化"
      ]
    },
    {
      "dot": "amber",
      "title": "扩展点",
      "items": [
        "自定义 CallAdapter 实现 adapt(Call) 即可接入 RxJava / 协程",
        "自定义 Converter 接管 Gson / Moshi / Protobuf 等格式"
      ]
    }
  ]
