  "cards": [
    {
      "dot": "cyan",
      "title": "安装与补丁两段式",
      "items": [
        "TinkerInstaller.install 建 Builder 后调 Tinker.install，install 内把 AbstractPatch 交给 TinkerPatchService 静态持有",
        "打补丁在 :patch 独立进程的 IntentService 里执行，避免污染主进程内存中的补丁状态"
      ]
    },
    {
      "dot": "violet",
      "title": "加载只读产物",
      "items": [
        "TinkerLoader 读 tinker/patch.info 与 guard 锁，版本变更只由主进程推进",
        "TinkerDexLoader 只校验并调用 SystemClassLoaderAdder，dex 真正生效发生在下一次进程启动"
      ]
    }
  ]
}