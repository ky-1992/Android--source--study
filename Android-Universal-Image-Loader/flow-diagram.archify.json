  "cards": [
    {
      "dot": "cyan",
      "title": "内存优先",
      "items": [
        "ImageLoader.displayImage 先按 URI + targetSize 生成 key 查内存缓存，命中且未被回收就直接 displayer.display",
        "只有未命中才构造 ImageLoadingInfo 并 engine.submit，避免无谓线程切换"
      ]
    },
    {
      "dot": "violet",
      "title": "任务内二次判定",
      "items": [
        "任务在 URI 锁内再查一次内存缓存，然后按磁盘命中、网络下载、解码的顺序取图",
        "最终结果包成 DisplayBitmapTask，经 Handler 回主线程写入 ImageAware"
      ]
    }
