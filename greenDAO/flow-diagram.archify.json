  "cards": [
    {
      "dot": "cyan",
      "title": "事务策略",
      "items": [
        "executeInsert 先用 isDbLockedByCurrentThread 判断是否已在事务中，避免嵌套 beginTransaction",
        "批量入口 executeInsertInTx 只开一次事务并锁住 statement，identityScope 用 putNoLock 减少重复加锁"
      ]
    },
    {
      "dot": "violet",
      "title": "语句缓存与主键",
      "items": [
        "TableStatements 用双检锁按表缓存 INSERT / UPDATE / DELETE 预编译语句，SQL 只拼一次",
        "updateKeyAfterInsertAndAttach 回填主键后 attachEntity 把对象放进 IdentityScope，使内存中同一主键只有一份实例"
      ]
    }
  ]
