  "cards": [
    {
      "dot": "cyan",
      "title": "三层视图",
      "items": [
        "UCropView 是 FrameLayout：下层 GestureCropImageView 画图片，上层 OverlayView 画遮罩、裁剪框与九宫格",
        "UCropView.setListenersToViews 把 CropBoundsChangeListener 与 OverlayViewChangeListener 交叉接起来，实现比例与裁剪框双向同步"
      ]
    },
    {
      "dot": "violet",
      "title": "变换模型",
      "items": [
        "TransformImageView 用 Matrix 维护 translate/scale/rotate，postScale/postRotate 后立即 setImageMatrix 并回调监听器",
        "CropImageView 在 TransformImageView 之上叠加 mCropRect 与 mMinScale/mMaxScale，setImageToWrapCropBounds 保证图片始终盖住裁剪框"
      ]
    },
    {
      "dot": "amber",
      "title": "两个 AsyncTask",
      "items": [
        "BitmapLoadTask 在后台按 maxBitmapSize 解码并校正 EXIF，onPostExecute 回到主线程设置 Bitmap",
        "BitmapCropTask 在 doInBackground 里 resize/rotate/裁剪并通过 native cropCImg 落盘，onPostExecute 回调 onBitmapCropped 或 onCropFailure"
      ]
    }
  ]
}