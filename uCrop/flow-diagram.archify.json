  "cards": [
    {
      "dot": "cyan",
      "title": "手势与裁剪框",
      "items": [
        "GestureCropImageView.onTouchEvent 把事件同时分发给 ScaleGestureDetector、RotationGestureDetector 与 GestureDetector，抬手后 setImageToWrapCropBounds 让图片重新盖满裁剪框",
        "OverlayView 只在 freestyle 模式下处理触摸，拖动四角改写 mCropViewRect，松手时通过 OverlayViewChangeListener 回调给 CropImageView.setCropRect"
      ]
    },
    {
      "dot": "violet",
      "title": "异步与回传",
      "items": [
        "BitmapLoadTask 按 maxBitmapSize 计算 inSampleSize 解码并修正 EXIF，成功后 UCropView 才真正显示图片",
        "BitmapCropTask 先 resize 再调用 native cropCImg 落盘，onBitmapCropped 回传 Uri、offset 与宽高，UCropActivity.setResultUri 写入 RESULT_OK"
      ]
    }
  ]
