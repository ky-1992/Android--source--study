  "cards": [
    {
      "dot": "cyan",
      "title": "触底判定",
      "items": [
        "scroll_load_more_detection 先按 Grid/StaggeredGrid/Linear 三种 LayoutManager 取首个与最后可见位置",
        "bottomEdgeHit 的条件是 (总数 - 可见数) <= 首个可见位置，命中后只触发一次 loadMore"
      ]
    },
    {
      "dot": "violet",
      "title": "Footer 与刷新",
      "items": [
        "加载更多视图作为 FOOTER 类型复用，数量为 0 时先隐藏；enableLoadMore 通过 Handler 延迟生效",
        "VerticalSwipeRefreshLayout 在水平位移超过 touchSlop 时放弃拦截，避免和横向滑动冲突"
      ]
    }
  ]
