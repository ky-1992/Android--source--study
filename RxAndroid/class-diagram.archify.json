  "cards": [
    {
      "dot": "cyan",
      "title": "最小绑定层",
      "items": [
        "RxAndroid 只补主线程调度器：AndroidSchedulers.mainThread() 返回 HandlerScheduler，其余能力都来自 RxJava 3",
        "Scheduler / Worker / Disposable 三个外部契约不在此仓库内，图中仅标出继承与实现关系"
      ]
    },
    {
      "dot": "violet",
      "title": "取消与释放",
      "items": [
        "HandlerWorker.dispose 用 worker 自身作为 token 调 removeCallbacksAndMessages，一次性取消整批任务",
        "MainThreadDisposable 用 CAS 保证 onDispose 只执行一次，非主线程调用时经 mainThread().scheduleDirect 切回主线程"
      ]
    }
  ]
}