  "cards": [
    {
      "dot": "cyan",
      "title": "编译期链路",
      "items": [
        "Javac 与 KSP 各有一个薄处理器，真正的处理逻辑都交给 DelegateComponentProcessor",
        "delegate 自身由 Dagger 的 @Component 注入依赖，处理器用自己编译自己，形成自举"
      ]
    },
    {
      "dot": "violet",
      "title": "两条生成产物",
      "items": [
        "ComponentProcessingStep 先做 FullBindingGraph 校验，再对局部图生成组件实现",
        "postRound 里 InjectBindingRegistry 还会为 @Inject/@Provides 生成 Factory 与 MembersInjector"
      ]
    }
  ]
