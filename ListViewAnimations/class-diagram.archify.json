  "cards": [
    {
      "dot": "cyan",
      "title": "装饰链",
      "items": [
        "BaseAdapterDecorator 把所有 BaseAdapter 方法原样转发，子类只覆盖需要增强的一两个",
        "getRootAdapter 用 while 循环剥掉所有装饰器；setListViewWrapper 会向下传播给被装饰者"
      ]
    },
    {
      "dot": "violet",
      "title": "动画只播一次",
      "items": [
        "ViewAnimator 以 mLastAnimatedPosition 判断是否已播，convertView 复用前先 cancelExistingAnimation",
        "AnimationAdapter 把子装饰器 Animator 与自身 Animator、alpha 0→1 合并后交给 AnimatorSet，并按位置计算 startDelay"
      ]
    },
    {
      "dot": "amber",
      "title": "手势分层",
      "items": [
        "SwipeTouchListener 只做手势状态机，SwipeDismissTouchListener 在 afterViewFling 里接高度折叠动画"
      ]
    }
  ]
}