      ]
    },
    {
      "dot": "amber",
      "title": "侧滑收尾",
      "items": [
        "performDismiss 用 ValueAnimator 把高度从 view 高度折到 1，全部动画结束后 finalizeDismiss 汇总 positions 倒序回调 OnDismissCallback"
      ]
    }
