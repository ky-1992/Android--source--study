  "cards": [
    {
      "dot": "cyan",
      "title": "三种排布",
      "items": [
        "isShiftingMode() 只看 behaviors 位掩码里的 BEHAVIOR_SHIFTING，且与 tablet 互斥（L220-222、L338-344）",
        "宽度由 resizeTabsToCorrectSizes 按屏宽均分，shifting 下激活项额外拿到 9:1 的份额（L383-420）"
      ]
    },
    {
      "dot": "violet",
      "title": "动画切换",
      "items": [
        "select/deselect 统一用 150ms ValueAnimator 改色、缩放与 padding（BottomBarTab L384-431、L433-445）",
        "背景色切换 5.0+ 走 circular reveal，低版本退化为 crossfade（BottomBar L991-1011）"
      ]
    }
  ]
