  "cards": [
    {
      "dot": "cyan",
      "title": "Scrollable 只定协议",
      "items": [
        "add / remove / clear 三件套支持多个监听者；setScrollViewCallbacks 仅为兼容旧版保留的弃用入口",
        "scrollVerticallyTo 与 getCurrentScrollY 让调用方不必关心 ScrollView、ListView 还是 RecyclerView"
      ]
    },
    {
      "dot": "violet",
      "title": "两种位置换算",
      "items": [
        "ScrollView 直接读取 onScrollChanged 的 t 并和 mPrevScrollY 比较，得出 UP / DOWN",
        "ListView / RecyclerView 以第一个可见子项为锚点，累加已滚过子项高度再减去 getTop，估算出连续 scrollY"
      ]
    }
  ]
}