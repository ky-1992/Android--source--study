  "cards": [
    {
      "dot": "cyan",
      "title": "引用队列检测",
      "items": [
        "expectDeletionOnTriggerFor 为每个对象建 KeyedWeakReference 并放进 ConcurrentHashMap，key 用 UUID",
        "对象变弱可达时 JVM 自动把引用入 ReferenceQueue；removeWeaklyReachableObjects 轮询队列并删除已入队条目"
      ]
    },
    {
      "dot": "violet",
      "title": "何时转储",
      "items": [
        "checkRetainedObjects 先 GC 再读 retainedObjectCount，前台需达到 retainedVisibleThreshold，后台只需 >0",
        "两次转储间有 WAIT_BETWEEN_HEAP_DUMPS_MILLIS 间隔，转储前把 KeyedWeakReference.heapDumpUptimeMillis 写为当前 uptime"
      ]
    },
    {
      "dot": "amber",
      "title": "Shark 分析",
      "items": [
        "HeapAnalyzer.analyze 用 PrioritizingShortestPathFinder 找「泄漏对象 → GC Root」最短强引用链",
        "按 referenceMatchers 过滤已知库泄漏，结果封装成 HeapAnalysisSuccess（applicationLeaks / libraryLeaks）"
      ]
    }
  ]
}
