  "cards": [
    {
      "dot": "cyan",
      "title": "Kotlin 重写后的结构",
      "items": [
        "3.x 不再有 Builder 与 DialogWrapper：配置改成链式方法，构造时直接 inflate 根布局",
        "DialogBehavior 把主题选择、窗口尺寸、背景圆角等平台细节抽成可替换策略"
      ]
    },
    {
      "dot": "violet",
      "title": "点击与销毁",
      "items": [
        "DialogActionButtonLayout 在 onFinishInflate 给三个按钮统一注册 dialog.onActionButtonClicked(which)",
        "onActionButtonClicked 先 invokeAll 对应回调，autoDismissEnabled 为 true 时再 dismiss"
      ]
    }
  ]
