  "cards": [
    {
      "dot": "cyan",
      "title": "注入链",
      "items": [
        "getSystemService 返回 CalligraphyLayoutInflater，使 Activity 的 inflate 全部走注入版",
        "CalligraphyLayoutInflater 把外层 Factory/Factory2 包成 Wrapper，回调后交给 CalligraphyFactory"
      ]
    },
    {
      "dot": "violet",
      "title": "字体来源优先级",
      "items": [
        "resolveFontPath 依次试 xml 属性、style、TextAppearance，再退回主题 attr 与 Config 默认路径",
        "TypefaceUtils 用 sCachedFonts 按路径缓存，isLoaded 避免重复设置"
      ]
    }
  ]
}