  "cards": [
    {
      "dot": "cyan",
      "title": "为什么改 Context",
      "items": [
        "LayoutInflater 由 Context.getSystemService 提供，wrap 后 Activity 内所有 inflate 自然走注入版",
        "CalligraphyLayoutInflater 用 WrapperFactory2 包住外部 Factory2，回调后再应用字体"
      ]
    },
    {
      "dot": "amber",
      "title": "字体路径回退顺序",
      "items": [
        "xml 属性 → style → TextAppearance → 主题 attr（含 ActionBar 标题特判）→ Config 默认路径",
        "每条路径都过 TypefaceUtils.load，按文件路径命中 sCachedFonts 即复用"
      ]
    }
  ]
