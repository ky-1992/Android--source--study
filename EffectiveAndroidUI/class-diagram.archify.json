  "cards": [
    {
      "dot": "cyan",
      "title": "两种表现层模式",
      "items": [
        "TvShowCatalogPresenter 与 TvShowPresenter 走 MVP：Presenter 持有 View 接口并直接调用视图方法",
        "TvShowViewModel 走 MVVM：通过 Listener 回调把状态变化推给 TvShowFragment，并用 ActionCommand 封装点击"
      ]
    },
    {
      "dot": "violet",
      "title": "Dagger 装配",
      "items": [
        "TvShowsApplication.onCreate 创建 RootModule 根图；BaseActivity 用 getModules 做 plus 形成 Activity 作用域",
        "TvShowsModule 用 @Provides 把 Interactor 实例以 GetTvShows / GetTvShowById 接口暴露，Presenter 只依赖接口"
      ]
    }
  ]
}