  "cards": [
    {
      "dot": "cyan",
      "title": "嵌套滚动的让渡",
      "items": [
        "dispatchTouchEvent 用 dy 方向与 ScrollableViewHelper 的滚动余量决定谁处理这次手势",
        "列表顶部继续上拉时把事件转给面板，面板收起时转回列表，必要时补发 CANCEL/DOWN"
      ]
    },
    {
      "dot": "amber",
      "title": "松手吸附规则",
      "items": [
        "有速度：朝展开方向且未过锚点则停锚点，过了则全展开；反向同理回到锚点或收起",
        "无速度：按 (1+anchor)/2 与 anchor/2 两个阈值决定展开、锚定或收起"
      ]
    }
  ]
