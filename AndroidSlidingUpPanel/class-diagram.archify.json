  "cards": [
    {
      "dot": "cyan",
      "title": "布局契约",
      "items": [
        "必须是恰好 2 个子 View：第 0 个是主内容，第 1 个是可滑动面板，onMeasure 里直接抛异常校验",
        "mIsSlidingUp 由 gravity 决定，所有 top 计算都围绕 computePanelTopPosition 的 offset 展开"
      ]
    },
    {
      "dot": "violet",
      "title": "状态机",
      "items": [
        "拖动中置 DRAGGING，松手后由 onViewDragStateChanged 依 offset 收敛到 EXPANDED/COLLAPSED/ANCHORED/HIDDEN",
        "setPanelState 走 smoothSlideTo → ViewDragHelper.smoothSlideViewTo → computeScroll 逐帧推进"
      ]
    }
  ]
