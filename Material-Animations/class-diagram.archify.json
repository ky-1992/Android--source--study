  "cards": [
    {
      "dot": "cyan",
      "title": "共享元素链路",
      "items": [
        "TransitionHelper 先取 decorView 的 statusBar/navBar，再补调用方传入的 Pair，避免系统栏闪烁",
        "ActivityOptionsCompat.makeSceneTransitionAnimation 把 Pair 映射写入 Bundle，目标页按同名 transitionName 参与 ChangeBounds"
      ]
    },
    {
      "dot": "violet",
      "title": "窗口过渡配置",
      "items": [
        "TransitionActivity1 用 Fade 入场、excludeTarget 排除方块视图；返回时改设 Slide",
        "TransitionActivity2/3 按 type 在代码里 new Explode/Slide，或交给 TransitionInflater 读 XML"
      ]
    }
  ]
}