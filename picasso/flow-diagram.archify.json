  "cards": [
    {
      "dot": "cyan",
      "title": "主线程边界",
      "items": [
        "into 与 cancelExistingRequest 都要求主线程；submit 只把 Action 投给 Dispatcher，不做阻塞 IO",
        "HandlerDispatcher 用一个专用 HandlerThread 串行化 submit/cancel/pause，线程池只负责真正加载"
      ]
    },
    {
      "dot": "violet",
      "title": "缓存命中路径",
      "items": [
        "RequestCreator.into 在创建 Action 之前先 quickMemoryCacheCheck，命中就直接 setResult 并回调 onSuccess",
        "图片写回时 PicassoDrawable 负责 fade 过渡与 debug 指示器，noFade 可关闭"
      ]
    },
    {
      "dot": "amber",
      "title": "失败与取消",
      "items": [
        "请求失败进入 failedActions，网络恢复（NetworkBroadcastReceiver）时 flushFailedActions 重放",
        "同一 key 的 hunter 复用，attach/detach 维护 Action 列表；全部取消后 hunter.future 被 cancel"
      ]
    }
  ]
}
