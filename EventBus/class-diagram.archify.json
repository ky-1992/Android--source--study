  "cards": [
    {
      "dot": "cyan",
      "title": "注册路径",
      "items": [
        "register 先向 SubscriberMethodFinder 取方法列表，再在 synchronized 块内逐个 subscribe",
        "subscribe 按 priority 插入 CopyOnWriteArrayList，并让 sticky 订阅补收最近事件"
      ]
    },
    {
      "dot": "violet",
      "title": "投递路径",
      "items": [
        "post 之后的 postToSubscription 按 ThreadMode 选择直调或 Poster 入队",
        "Subscription.active 为 volatile，unregister 置 false 后已入队的事件会被跳过"
      ]
    }
  ]
