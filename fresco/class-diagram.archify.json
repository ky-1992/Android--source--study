  "cards": [
    {
      "dot": "cyan",
      "title": "请求入口",
      "items": [
        "ImagePipeline.fetchDecodedImage 先用 ProducerSequenceFactory 选链，再由 submitFetchRequest 包成 SettableProducerContext",
        "返回的 DataSource 由 CloseableProducerToDataSourceAdapter 把 Producer 回调翻译成 DataSource 事件"
      ]
    },
    {
      "dot": "violet",
      "title": "缓存分层",
      "items": [
        "BitmapMemoryCacheGetProducer 只读位图缓存，命中即返回；未命中才走 DecodeProducer 与磁盘/网络取数",
        "DecodeProducer 用 Executor 做增量解码，onNewResult(isLast=false) 先把中间结果交给上层"
      ]
    }
  ]
}