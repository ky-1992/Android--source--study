  "cards": [
    {
      "dot": "cyan",
      "title": "注册路径",
      "items": [
        "register 先用 handlerFinder 找生产者，putIfAbsent 到 producersByType，重复注册直接抛异常",
        "再把处理器 addAll 进 CopyOnWriteArraySet；已有生产者的类型会立刻补发一次生产者结果"
      ]
    },
    {
      "dot": "violet",
      "title": "投递路径",
      "items": [
        "post 先 flattenHierarchy 展开父类链（getClassesFor 只沿 superclass 走），再按类型逐个入队",
        "dispatchQueuedEvents 用 isDispatching 防重入，事件按入队顺序反射调用，无订阅者则包成 DeadEvent"
      ]
    }
  ]
}