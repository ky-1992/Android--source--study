  "cards": [
    {
      "dot": "cyan",
      "title": "线程约束",
      "items": [
        "register / unregister / post 入口都先调 enforcer.enforce(this)，默认 ThreadEnforcer.MAIN 会在非主线程直接抛 IllegalStateException",
        "构造 Bus 时可传入 ThreadEnforcer.ANY 或自定义实现来放开约束"
      ]
    },
    {
      "dot": "violet",
      "title": "重入与死信",
      "items": [
        "dispatchQueuedEvents 用 ThreadLocal<Boolean> isDispatching 防重入，处理中再次 post 的事件留在队列末尾顺序执行",
        "unregister 把 EventHandler.invalidate()，已入队但已注销的处理器会被 isValid 检查跳过"
      ]
    }
  ]
