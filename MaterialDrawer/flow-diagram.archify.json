  "cards": [
    {
      "dot": "cyan",
      "title": "构建只允许一次",
      "items": [
        "build()/buildView() 先查 mUsed，第二次调用直接抛异常；append() 可给已有抽屉追加第二份内容",
        "buildView() 末尾把 mActivity 置空，之后的 Drawer 只操作已建好的 View 和适配器"
      ]
    },
    {
      "dot": "violet",
      "title": "点击后的分支",
      "items": [
        "点击先触发条目自身的 onDrawerItemClickListener，再触发 Drawer 级监听，MiniDrawer 只在未消费时接管",
        "展开型条目（subItems 非空）会吞掉事件不关闭抽屉；其余条目走 closeDrawerDelayed"
      ]
    }
  ]
