  "cards": [
    {
      "dot": "cyan",
      "title": "状态迁移由 setState 单点驱动",
      "items": [
        "setState 按 mState 分发到 onPullToRefresh / onReleaseToRefresh / onRefreshing / onReset",
        "状态变化后统一回调 OnPullEventListener，用于音效等外部联动"
      ]
    },
    {
      "dot": "violet",
      "title": "视图与状态解耦",
      "items": [
        "LoadingLayout 只暴露 onPull / pullToRefresh / releaseToRefresh / refreshing / reset",
        "具体动画由 Rotate/Flip 子类实现 abstract 的 *Impl 方法"
      ]
    },
    {
      "dot": "amber",
      "title": "Mode 决定方向与加载区",
      "items": [
        "Mode.BOTH 时用 mCurrentMode 区分 PULL_FROM_START / PULL_FROM_END",
        "showHeaderLoadingLayout / showFooterLoadingLayout 决定创建哪个加载区"
      ]
    }
  ]
}