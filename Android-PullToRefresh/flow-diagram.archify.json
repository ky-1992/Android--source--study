  "cards": [
    {
      "dot": "cyan",
      "title": "距离换算",
      "items": [
        "pullEvent 把指尖位移除以 FRICTION=2.0 得到 header 偏移",
        "scale = |scroll| / itemDimension，交给 onPull 驱动子类动画"
      ]
    },
    {
      "dot": "amber",
      "title": "两条判定线",
      "items": [
        "itemDimension >= |scroll| 进入 PULL_TO_REFRESH",
        "超过 itemDimension 后切到 RELEASE_TO_REFRESH，松手才真正刷新"
      ]
    },
    {
      "dot": "emerald",
      "title": "回调时机",
      "items": [
        "doScroll 且 mShowViewWhileRefreshing 时，等平滑滚动结束再 callRefreshListener",
        "onRefreshComplete 只在 isRefreshing() 时切回 RESET"
      ]
    }
  ]
