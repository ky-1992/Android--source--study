  "cards": [
    {
      "dot": "cyan",
      "title": "属性即主题",
      "items": [
        "每个控件在 initialise 里用 obtainStyledAttributes 读品牌/尺寸序号，再换算成 float 倍数",
        "DefaultBootstrapSize 的 scaleFactor 固定为 0.70、0.85、1.00、1.30、1.60"
      ]
    },
    {
      "dot": "violet",
      "title": "Drawable 运行时生成",
      "items": [
        "BootstrapDrawableFactory 用 GradientDrawable + StateListDrawable 组合出默认/按下/禁用三态",
        "成组按钮靠 ViewGroupPosition 只保留外侧圆角，并用负 inset 隐藏相邻描边"
      ]
    }
  ]
