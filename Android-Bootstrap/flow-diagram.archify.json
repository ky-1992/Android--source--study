  "cards": [
    {
      "dot": "cyan",
      "title": "属性到倍数",
      "items": [
        "BootstrapButton.initialise 读 roundedCorners / showOutline / bootstrapSize 等序号，默认走 MD",
        "基线字号、内边距、描边、圆角先按资源取像素，再统一乘以 bootstrapSize"
      ]
    },
    {
      "dot": "violet",
      "title": "状态与圆角",
      "items": [
        "setupDrawableCorners 按 ViewGroupPosition 决定保留哪几个角，SOLO 才是四角全圆",
        "setupStateDrawable 用负 inset 隐藏相邻边描边，再按 hovered/pressed/disabled 挂三份 LayerDrawable"
      ]
    }
  ]
