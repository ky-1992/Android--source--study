  "cards": [
    {
      "dot": "cyan",
      "title": "装配顺序",
      "items": [
        "子类在 onCreate 里 addSlide，基类再在 onPostCreate 用 fragments.size 初始化指示器",
        "addSlide 在 RTL 下插到队首并 notifyItemInserted(0)，顺序与视觉方向一致"
      ]
    },
    {
      "dot": "amber",
      "title": "为什么用自己的手势层",
      "items": [
        "ViewPager2 一旦滑动就没法在中途否决，所以 isUserInputEnabled 置 false，改由 fakeDrag 转发",
        "策略未满足时 short-circuit 并节流 1 秒才回调 onIllegallyRequestedNextPage"
      ]
    },
    {
      "dot": "rose",
      "title": "权限状态机",
      "items": [
        "授予：从 permissionsMap 移除并 goToNextSlide；拒绝：required 才拦，否则也放行",
        "拒绝后 reCenterCurrentSlide 把 ViewPager 拽回原位，避免半开状态"
      ]
    }
  ]
}
