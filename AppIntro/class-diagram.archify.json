  "cards": [
    {
      "dot": "cyan",
      "title": "生命周期锚点",
      "items": [
        "onCreate 绑控件、建 PagerAdapter 与分页控制器，并挂上 Back 与按钮监听（L388–L445）",
        "onPostCreate 初始化指示器、把首个 slide 回调补发出去；无 slide 直接 finish（L447–L474）"
      ]
    },
    {
      "dot": "violet",
      "title": "权限与策略",
      "items": [
        "askForPermissions 把 slideNumber 映射成 PermissionWrapper（L167），翻页前先查表",
        "requestPermissions 先 setSwipeLock(true) 再请求，结果里区分“可再问”与“不再询问”（L639、L690）"
      ]
    },
    {
      "dot": "amber",
      "title": "触摸被接管",
      "items": [
        "控制器把 isUserInputEnabled 置 false，改由 GestureOverlayView 收手势再 fakeDrag（L218–L254）",
        "这样 AppIntroBase 才能在滑动途中拒绝前进，而不是等页面已经换过去"
      ]
    }
  ]
