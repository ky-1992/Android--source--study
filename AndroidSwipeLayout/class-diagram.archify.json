  "cards": [
    {
      "dot": "cyan",
      "title": "拖拽内核",
      "items": [
        "mDragHelperCallback 只放行 surface 与当前 bottom 视图，clamp 按 DragEdge 把位移限制在 0~mDragDistance",
        "松手后 processHandRelease 先看速度，再按已拖出百分比与 0.25/0.75 阈值决定 open 或 close"
      ]
    },
    {
      "dot": "violet",
      "title": "适配器侧状态",
      "items": [
        "SwipeItemMangerImpl.bind 给每个 item 挂 OnLayoutListener 与 SwipeMemory，复用 View 时只改 position",
        "Single 模式下 SwipeMemory 在 onStartOpen 里 closeAllExcept，保证列表同时只开一条"
      ]
    }
  ]
}