  "cards": [
    {
      "dot": "cyan",
      "title": "方向判定规则",
      "items": [
        "Close 状态下按移动角度选边：水平 45° 内选 Left/Right，否则选 Top/Bottom",
        "已打开或 Middle 状态时不再换边，直接用当前 mCurrentDragEdge 判断是否够格拖拽"
      ]
    },
    {
      "dot": "violet",
      "title": "落位与通知",
      "items": [
        "processHandRelease 以 getMinVelocity 为界，未过速则用 getLeft/getTop 算拖出百分比与阈值比较",
        "dispatchSwipeEvent 用 mEventCounter 只在首次移动发 onStartOpen/onStartClose，到 Open/Close 后再发终态回调"
      ]
    }
  ]
