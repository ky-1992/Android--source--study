  "cards": [
    {
      "dot": "cyan",
      "title": "两层视图模型",
      "items": [
        "SlidingMenu 本身是 RelativeLayout：CustomViewAbove 放内容，CustomViewBehind 放菜单",
        "拖动时 CustomViewAbove 让内容平移，CustomViewBehind 按 scrollScale 做视差"
      ]
    },
    {
      "dot": "violet",
      "title": "动画扩展",
      "items": [
        "CanvasTransformer 可对菜单层 Canvas 做缩放/旋转/自定义变换",
        "OnOpen/OnClose/OnOpened/OnClosed 四个监听覆盖完整状态流转"
      ]
    }
