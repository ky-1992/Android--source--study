  "cards": [
    {
      "dot": "cyan",
      "title": "数据与视图分离",
      "items": [
        "Chart 只持有 ChartData、ViewPortHandler 与 DataRenderer；具体图表在 init 里装配自己的 Renderer 和 Highlighter",
        "数据改动后必须走 Chart.data setter 或 notifyDataSetChanged，才会重算极值、轴范围与边距"
      ]
    },
    {
      "dot": "violet",
      "title": "坐标与绘制链",
      "items": [
        "BarLineChartBase.onDraw 先算轴与网格，再依次调用 renderer.drawData / drawHighlighted / drawValues",
        "Transformer 用 matrixValueToPx 与 matrixOffset 两级矩阵把 Entry 的值域坐标映射到内容区像素"
      ]
    }
  ]
}